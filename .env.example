# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Required for production (e.g. a MongoDB Atlas connection string).
# Local development may omit it and use data/db.json.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/na_distributors?retryWrites=true&w=majority"

# Production authentication secrets. Keep these in GCP Secret Manager, not in source control.
# SESSION_SECRET must be a random value with at least 32 characters.
SESSION_SECRET=""
# INITIAL_ADMIN_PASSWORD must be at least 12 characters; used to replace a seeded default admin password.
INITIAL_ADMIN_PASSWORD=""

# Optional Google Maps JavaScript API key for local development.
# This key is sent to browsers; restrict it by HTTP referrer and allowed APIs.
VITE_GOOGLE_MAPS_API_KEY=""
